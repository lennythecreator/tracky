{
  "name": "tracky",
  "version": "0.1.0",
  "description": "A lightweight, backend-agnostic React analytics SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tracky": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:playground": "vite --config website/playground/vite.config.ts",
    "build:playground": "tsc --noEmit -p website/playground/tsconfig.json && vite build --config website/playground/vite.config.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
