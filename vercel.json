{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:playground && npm run build:docs",
  "outputDirectory": "website",
  "rewrites": [
    { "source": "/docs", "destination": "/docs/dist/index.html" },
    { "source": "/docs/", "destination": "/docs/dist/index.html" },
    { "source": "/docs/(.*)", "destination": "/docs/dist/index.html" },
    { "source": "/playground", "destination": "/playground/dist/index.html" },
    { "source": "/playground/", "destination": "/playground/dist/index.html" },
    { "source": "/playground/(.*)", "destination": "/playground/dist/index.html" }
  ]
}
